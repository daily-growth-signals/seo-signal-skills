---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>{{ site.baseUrl }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.baseUrl }}/blog/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
{%- for post in collections.posts or [] %}
  <url>
    <loc>{{ post.url | absoluteUrl(site) }}</loc>
    <lastmod>{{ post.data.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    {%- set altEn = collections.posts | alternatePost(post.data.slug, 'en') %}
    {%- set altZh = collections.posts | alternatePost(post.data.slug, 'zh') %}
    {%- if altEn %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ altEn.url | absoluteUrl(site) }}" />
    {%- endif %}
    {%- if altZh %}
    <xhtml:link rel="alternate" hreflang="zh" href="{{ altZh.url | absoluteUrl(site) }}" />
    {%- endif %}
    {%- if altEn %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ altEn.url | absoluteUrl(site) }}" />
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
